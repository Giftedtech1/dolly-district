<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% comment %} Open Graph {% endcomment %}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  {% if page_image %}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">

  {{ content_for_header }}

  {% style %}
    {%- if settings.font_heading.family -%}{{ settings.font_heading | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if settings.font_body.family -%}{{ settings.font_body | font_face: font_display: 'swap' }}{%- endif -%}

    :root {
      --color-background: {{ settings.color_background.red }}, {{ settings.color_background.green }}, {{ settings.color_background.blue }};
      --color-background-secondary: {{ settings.color_background_secondary.red }}, {{ settings.color_background_secondary.green }}, {{ settings.color_background_secondary.blue }};
      --color-white: {{ settings.color_white.red }}, {{ settings.color_white.green }}, {{ settings.color_white.blue }};
      --color-text: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
      --color-text-muted: {{ settings.color_text_muted.red }}, {{ settings.color_text_muted.green }}, {{ settings.color_text_muted.blue }};
      --color-accent: {{ settings.color_accent.red }}, {{ settings.color_accent.green }}, {{ settings.color_accent.blue }};
      --color-border: {{ settings.color_border.red }}, {{ settings.color_border.green }}, {{ settings.color_border.blue }};
      --color-sale: {{ settings.color_sale.red }}, {{ settings.color_sale.green }}, {{ settings.color_sale.blue }};
      --color-button-background: {{ settings.color_button_background.red }}, {{ settings.color_button_background.green }}, {{ settings.color_button_background.blue }};
      --color-button-text: {{ settings.color_button_text.red }}, {{ settings.color_button_text.green }}, {{ settings.color_button_text.blue }};
      --color-button-secondary-background: {{ settings.color_button_secondary_background.red }}, {{ settings.color_button_secondary_background.green }}, {{ settings.color_button_secondary_background.blue }};
      --color-button-secondary-text: {{ settings.color_button_secondary_text.red }}, {{ settings.color_button_secondary_text.green }}, {{ settings.color_button_secondary_text.blue }};

      --font-heading-family: {{ settings.font_heading.family }}, serif;
      --font-heading-style: {{ settings.font_heading.style }};
      --font-heading-weight: {{ settings.font_heading.weight }};
      --font-heading-scale: {{ settings.font_heading_scale }}%;
      --font-body-family: {{ settings.font_body.family }}, sans-serif;
      --font-body-style: {{ settings.font_body.style }};
      --font-body-weight: {{ settings.font_body.weight }};
      --font-body-scale: {{ settings.font_body_scale }}%;
      --heading-letter-spacing: {{ settings.heading_letter_spacing }}px;

      --page-width: {{ settings.page_width }}px;
      --spacing-sections: {{ settings.spacing_sections }}px;
      --grid-gap: {{ settings.grid_gap }}px;
      --button-radius: {{ settings.button_border_radius }}px;
      --button-text-transform: {{ settings.button_text_transform }};
    }
  {% endstyle %}

  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  {% if settings.enable_animations == false %}
    <style>*,*::before,*::after{animation-duration:0.001ms!important;transition-duration:0.001ms!important;}</style>
  {% endif %}

  {%- if request.page_type == 'product' -%}
    {{ product | structured_data }}
  {%- endif -%}
</head>
<body class="template-{{ request.page_type | handleize }}">
  <a class="visually-hidden skip-to-content-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" class="main-content" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'cart-drawer' %}
  {% render 'size-guide' %}

  <div id="quick-add-modal" class="quick-add-modal" hidden>
    <div class="quick-add-modal__overlay" data-quick-add-close></div>
    <div class="quick-add-modal__panel" role="dialog" aria-modal="true" aria-label="Quick add">
      <button type="button" class="quick-add-modal__close" data-quick-add-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', icon: 'close' %}
      </button>
      <div class="quick-add-modal__content" data-quick-add-content></div>
    </div>
  </div>
</body>
</html>
