<section class="section testimonials" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading section-heading--center">
        <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="testimonials__carousel" data-carousel role="region" aria-roledescription="{{ 'accessibility.carousel' | t }}">
      <div class="testimonials__track" data-carousel-track>
        {%- for block in section.blocks -%}
          <div class="testimonial-card" data-carousel-slide {{ block.shopify_attributes }}>
            <div class="testimonial-card__stars" aria-label="{{ 'accessibility.star_rating' | t: rating: block.settings.rating }}">
              {%- for i in (1..5) -%}
                <span class="{% if i <= block.settings.rating %}is-filled{% endif %}">{% render 'icon', icon: 'star' %}</span>
              {%- endfor -%}
            </div>
            <blockquote class="testimonial-card__text">"{{ block.settings.review }}"</blockquote>
            <div class="testimonial-card__author">
              {%- if block.settings.image -%}
                <img src="{{ block.settings.image | image_url: width: 100 }}" alt="{{ block.settings.name | escape }}" width="48" height="48" loading="lazy" class="testimonial-card__avatar">
              {%- endif -%}
              <div>
                <p class="testimonial-card__name">{{ block.settings.name }}</p>
                {%- if block.settings.verified -%}
                  <p class="testimonial-card__verified">
                    {% render 'icon', icon: 'check' %} {{ 'testimonials.verified_customer' | t }}
                  </p>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="testimonials__nav">
          <button type="button" class="testimonials__prev" data-carousel-prev aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
          <div class="testimonials__dots" data-carousel-dots></div>
          <button type="button" class="testimonials__next" data-carousel-next aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHAT SHE'S SAYING"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer name", "default": "Happy Customer" },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "The outfit was even better in person. Dolly District is officially my new obsession."
        },
        { "type": "image_picker", "id": "image", "label": "Customer image" },
        { "type": "checkbox", "id": "verified", "label": "Verified customer badge", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
