<section class="section newsletter-section" style="background-color: {{ section.settings.background_color }};" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="newsletter-section__inner reveal-up">
      {%- if section.settings.heading != blank -%}<h2 class="newsletter-section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="newsletter-section__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- render 'newsletter-form', id: 'Section-' | append: section.id -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F3E4E5"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIRST ACCESS. ALWAYS."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "New drops, private offers and a little fashion inspiration."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
