<section class="error-404 page-width" data-section-id="{{ section.id }}">
  <div class="error-404__content">
    <h1 class="error-404__title">{{ '404.title' | t }}</h1>
    <p class="error-404__text">{{ '404.subtext' | t }}</p>
    <a href="{{ routes.root_url }}" class="button button--primary">{{ '404.link' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404 page",
  "settings": []
}
{% endschema %}
