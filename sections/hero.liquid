<section class="hero hero--{{ section.settings.height }}" data-section-id="{{ section.id }}">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      <video class="hero__video" autoplay muted loop playsinline poster="{{ section.settings.image | image_url: width: 1600 }}">
        <source src="{{ section.settings.video.sources[1].url | default: section.settings.video.sources[0].url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image -%}
      <picture>
        {%- if section.settings.image_mobile -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">
        {%- endif -%}
        <img
          src="{{ section.settings.image | image_url: width: 1800 }}"
          srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1800 }} 1800w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | escape }}"
          class="hero__image"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      </picture>
    {%- else -%}
      <div class="hero__image hero__image--placeholder"></div>
    {%- endif -%}
    <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  </div>

  <div class="hero__content hero__content--{{ section.settings.text_position }} page-width">
    <div class="hero__content-inner reveal-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="hero__description">{{ section.settings.description }}</div>
      {%- endif -%}
      <div class="hero__buttons">
        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button button--primary">{{ section.settings.button_text }}</a>
        {%- endif -%}
        {%- if section.settings.button_text_secondary != blank -%}
          <a href="{{ section.settings.button_link_secondary | default: '#' }}" class="button button--outline">{{ section.settings.button_text_secondary }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video (optional, overrides image)"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DOLLY DISTRICT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DRESS LIKE THE MAIN CHARACTER."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary button text",
      "default": "SHOP NEW ARRIVALS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_text_secondary",
      "label": "Secondary button text"
    },
    {
      "type": "url",
      "id": "button_link_secondary",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
