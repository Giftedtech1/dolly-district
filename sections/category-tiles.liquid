<section class="section category-tiles" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading section-heading--{{ section.settings.heading_position }}">
        <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="category-tiles__grid category-tiles__grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="category-tile reveal-up" {{ block.shopify_attributes }}>
          <div class="category-tile__media">
            <picture>
              {%- if block.settings.image_mobile -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 700 }}">
              {%- endif -%}
              {%- if block.settings.image -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 750px) 33vw, 50vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {%- render 'placeholder-image', class: 'category-tile__image' -%}
              {%- endif -%}
            </picture>
            <div class="category-tile__overlay"></div>
          </div>
          <span class="category-tile__title category-tile__title--{{ block.settings.text_position }}">{{ block.settings.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "select",
      "id": "heading_position",
      "label": "Heading position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
        { "type": "text", "id": "title", "label": "Title", "default": "DRESSES" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            { "value": "bottom", "label": "Bottom" },
            { "value": "center", "label": "Center" }
          ],
          "default": "bottom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "DRESSES" } },
        { "type": "tile", "settings": { "title": "SETS" } },
        { "type": "tile", "settings": { "title": "TOPS" } },
        { "type": "tile", "settings": { "title": "BOTTOMS" } },
        { "type": "tile", "settings": { "title": "ACCESSORIES" } }
      ]
    }
  ]
}
{% endschema %}
