{%- comment -%}
  Accessible collapsible accordion item. Accepts: title, content, open
{%- endcomment -%}
{%- liquid
  assign accordion_id = title | handleize | append: '-' | append: section.id
-%}
<div class="accordion-item {% if open %}is-open{% endif %}" data-accordion-item>
  <h3 class="accordion-item__heading">
    <button
      type="button"
      class="accordion-item__trigger"
      id="Accordion-{{ accordion_id }}"
      aria-expanded="{% if open %}true{% else %}false{% endif %}"
      aria-controls="AccordionPanel-{{ accordion_id }}"
      data-accordion-trigger
    >
      <span>{{ title }}</span>
      {% render 'icon', icon: 'plus' %}
    </button>
  </h3>
  <div
    id="AccordionPanel-{{ accordion_id }}"
    class="accordion-item__panel"
    role="region"
    aria-labelledby="Accordion-{{ accordion_id }}"
    data-accordion-panel
    {% unless open %}hidden{% endunless %}
  >
    <div class="accordion-item__content">{{ content }}</div>
  </div>
</div>
