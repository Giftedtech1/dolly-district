{%- comment -%}
  Renders Shopify's native customer newsletter signup form.
  Accepts: id (unique suffix for form field ids)
{%- endcomment -%}
{%- form 'customer', id: 'NewsletterForm-' | append: id, class: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">
  <div class="newsletter-form__row">
    <label for="NewsletterEmail-{{ id }}" class="visually-hidden">{{ 'general.search.search' | t }}</label>
    <input
      type="email"
      name="contact[email]"
      id="NewsletterEmail-{{ id }}"
      class="newsletter-form__input"
      placeholder="Email address"
      required
      autocomplete="email"
    >
    <button type="submit" class="newsletter-form__submit button button--primary">JOIN</button>
  </div>

  {%- if form.posted_successfully? -%}
    <p class="newsletter-form__message newsletter-form__message--success" role="status">{{ 'newsletter.success' | t }}</p>
  {%- elsif form.errors -%}
    <p class="newsletter-form__message newsletter-form__message--error" role="alert">{{ 'newsletter.error' | t }}</p>
  {%- endif -%}
{%- endform -%}
