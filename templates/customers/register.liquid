<div class="page-width auth-page">
  <div class="auth-card">
    <h1>{{ 'general.account.register' | t }}</h1>

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div class="auth-card__errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <label for="FirstName">First name</label>
      <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">

      <label for="LastName">Last name</label>
      <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">

      <label for="Email">Email</label>
      <input type="email" name="customer[email]" id="Email" autocomplete="email" required>

      <label for="CreatePassword">Password</label>
      <input type="password" name="customer[password]" id="CreatePassword" autocomplete="new-password" required>

      <button type="submit" class="button button--primary">{{ 'general.account.register' | t }}</button>
    {%- endform -%}

    <p class="auth-card__switch">Already have an account? <a href="{{ routes.account_login_url }}">{{ 'general.account.login' | t }}</a></p>
  </div>
</div>
